<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Vehicle types -->
    <vType id="car"           accel="2.6" decel="4.5" sigma="0.5" length="4.5" maxSpeed="13.89" color="0,0,255"/>
    <vType id="bus"           accel="1.2" decel="3.0" sigma="0.3" length="12"  maxSpeed="11.11" color="0,255,0"/>
    <vType id="two_wheeler"   accel="3.0" decel="5.0" sigma="0.6" length="2.0" maxSpeed="16.67" color="255,165,0"/>
    <vType id="auto_rickshaw" accel="2.0" decel="4.0" sigma="0.5" length="3.0" maxSpeed="11.11" color="255,255,0"/>
    <vType id="truck"         accel="1.0" decel="3.0" sigma="0.4" length="8.0" maxSpeed="11.11" color="128,0,0"/>

    <!-- Morning peak flows (high density) -->
    <flow id="north_cars_peak"   type="car"         from="north_in" to="south_out" begin="0"    end="3600" vehsPerHour="400"/>
    <flow id="south_cars_peak"   type="car"         from="south_in" to="north_out" begin="0"    end="3600" vehsPerHour="380"/>
    <flow id="east_cars_peak"    type="car"         from="east_in"  to="west_out"  begin="0"    end="3600" vehsPerHour="350"/>
    <flow id="west_cars_peak"    type="car"         from="west_in"  to="east_out"  begin="0"    end="3600" vehsPerHour="320"/>

    <flow id="north_bikes"       type="two_wheeler" from="north_in" to="south_out" begin="0"    end="3600" vehsPerHour="200"/>
    <flow id="south_bikes"       type="two_wheeler" from="south_in" to="north_out" begin="0"    end="3600" vehsPerHour="180"/>
    <flow id="east_bikes"        type="two_wheeler" from="east_in"  to="west_out"  begin="0"    end="3600" vehsPerHour="150"/>

    <flow id="north_buses"       type="bus"         from="north_in" to="south_out" begin="0"    end="3600" vehsPerHour="30"/>
    <flow id="east_buses"        type="bus"         from="east_in"  to="west_out"  begin="0"    end="3600" vehsPerHour="25"/>

    <flow id="north_autos"       type="auto_rickshaw" from="north_in" to="east_out" begin="0"   end="3600" vehsPerHour="80"/>
    <flow id="south_autos"       type="auto_rickshaw" from="south_in" to="west_out" begin="0"   end="3600" vehsPerHour="70"/>

    <!-- Evening peak offset flow -->
    <flow id="east_cars_eve"     type="car"         from="east_in"  to="west_out"  begin="3600" end="7200" vehsPerHour="450"/>
    <flow id="west_cars_eve"     type="car"         from="west_in"  to="east_out"  begin="3600" end="7200" vehsPerHour="420"/>

</routes>
